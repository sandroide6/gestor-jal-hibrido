# ============================================================
# backend/.env.example — Plantilla de variables de entorno
# Gestor JAL v2.0 — Windows
# ============================================================
# INSTRUCCIONES:
#   1. Copia este archivo:  copy .env.example .env
#   2. Completa los valores indicados con "CAMBIAR"
#   3. NUNCA subas .env a git (ya está en .gitignore)
# ============================================================

# ── Base de datos (PostgreSQL local) ────────────────────────
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD
# Por defecto PostgreSQL en Windows usa el usuario 'postgres'
#
# Modo híbrido (backend en Render, Postgres en el PC local vía Tailscale):
# usa la IP de Tailscale del PC en vez de localhost, ej:
#   DATABASE_URL=postgresql://postgres:CAMBIAR_CONTRASEÑA@100.x.y.z:5432/gestor_jal
# Ver docs/DESPLIEGUE_HIBRIDO.md para el detalle completo.
DATABASE_URL=postgresql://postgres:CAMBIAR_CONTRASEÑA@localhost:5432/gestor_jal

# Fuerza (true) o desactiva (false) SSL en la conexión a Postgres, sin depender de la
# heurística automática (que activa SSL si el host de DATABASE_URL "tiene punto" — una
# IP de Tailscale también tiene puntos). Deja vacío para usar la heurística automática.
# Modo híbrido con Tailscale: DB_SSL=false (Postgres local no tiene certificados TLS).
DB_SSL=

# Variables individuales (usadas por el script de setup)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestor_jal
DB_USER=postgres
DB_PASSWORD=CAMBIAR_CONTRASEÑA

# ── JWT — Autenticación ──────────────────────────────────────
# Genera con: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=CAMBIAR_POR_UN_SECRET_LARGO_Y_ALEATORIO_MINIMO_32_CHARS

# Cifra en reposo los tokens OAuth de Google Drive. Obligatoria con NODE_ENV=production
# (el servidor no arranca si falta). Genera igual que JWT_SECRET.
ENCRYPTION_KEY=CAMBIAR_POR_OTRA_CLAVE_ALEATORIA

# Par RSA para RS256. OBLIGATORIO con NODE_ENV=production (el servidor no arranca sin él);
# en desarrollo, vacíos = HS256 con JWT_SECRET. Generación: ver docs/DESPLIEGUE_HIBRIDO.md
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ── Servidor ─────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# Protege GET /metrics (Prometheus) con "Authorization: Bearer <token>". Sin valor, en
# producción /metrics responde 404.
METRICS_TOKEN=

# ── CORS — Orígenes permitidos ───────────────────────────────
# Frontend local + URLs de ngrok se agregan automáticamente
# Modo híbrido: agrega el dominio de Vercel del frontend, ej:
#   ALLOWED_ORIGINS=https://gestor-jal.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# El propio host del servidor siempre se acepta (modo túnel local: el frontend se sirve
# desde el mismo backend). Los subdominios genéricos de túneles públicos (*.ngrok-free.app,
# *.trycloudflare.com, *.loca.lt, *.serveo.net) ya NO se aceptan: cualquiera puede crear
# uno. Solo para pruebas puntuales: ALLOW_TUNNEL_ORIGINS=true
# ALLOW_TUNNEL_ORIGINS=false
# SameSite de las cookies de sesión con HTTPS. Por defecto lax (el frontend llama a la API
# por el mismo origen). Solo si el frontend llama al backend en OTRO dominio: none.
# COOKIE_SAMESITE=lax

# ── Chat IA — Ollama (opcional) ───────────────────────────────
# Deja vacío si no usas el chat. En modo híbrido, Ollama sigue corriendo en el PC
# local — usa la misma IP/host de Tailscale que DATABASE_URL, no localhost.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# ── Almacenamiento de archivos ────────────────────────────────
# Ruta donde se guardan los documentos .docx/.pdf generados
STORAGE_PATH=./data/output
# Ruta de las plantillas .docx de la JAL
TEMPLATES_PATH=./plantillas
# Tamaño máximo de archivos subidos (MB)
MAX_FILE_SIZE_MB=20

# ── Configuración de la JAL ───────────────────────────────────
# Nota: el backend no lee estas dos variables (las usa solo el asistente scripts/setup.py).
# El nombre que se ve en la aplicación sale de la tabla jals (pantalla Configuración JAL).
JAL_NOMBRE=JAL Comuna 12 - La América - Medellín
JAL_NOMBRE_CORTO=JAL C12

# ── ngrok — Acceso remoto gratuito ────────────────────────────
# Obtén tu token en: https://dashboard.ngrok.com/get-started/your-authtoken
# Dejar vacío para desactivar el túnel
NGROK_AUTHTOKEN=
# Dominio fijo (solo plan pago de ngrok) — dejar vacío si usas el gratuito
NGROK_DOMAIN=

# ── Notificaciones push (opcional) ───────────────────────────
# Nota: las notificaciones push NO están implementadas; estas variables no se usan hoy.
# Genera con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@jal12.com

# ── Otras variables opcionales que lee el backend ─────────────
# Saltos de proxy de confianza para obtener la IP real (límite de intentos de login).
# TRUST_PROXY_HOPS=1
# Contraseña del administrador que crea el seeder. Obligatoria con NODE_ENV=production
# (el seeder se niega a usar la de ejemplo). El administrador debe cambiarla al entrar.
# ADMIN_INITIAL_PASSWORD=
# Copias a Google Drive (credenciales OAuth de una app web de Google Cloud)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3001/v1/backup/drive/callback
# Carpeta de copias locales generadas por el servidor
# BACKUPS_LOCAL_PATH=
# Receptor de documentos en un PC local (scripts/local_doc_receiver.js)
# LOCAL_DOC_RECEIVER_URL=
# LOCAL_DOC_RECEIVER_TOKEN=
# Mostrar las consultas SQL en el registro (solo depuración)
# LOG_SQL=false

# ── Correcciones de la auditoría 2026-11-05 ─────────────────────────────────
# CA de Supabase (Project Settings › Database › SSL Configuration › Download certificate).
# Pega el PEM completo (con \n) o una ruta a un archivo. Con ella se verifica el
# certificado del servidor; sin ella la conexión va cifrada pero sin verificar.
DB_SSL_CA=
# Alternativa a DB_SSL_CA: verificar contra las CA del sistema.
# DB_SSL_VERIFY=true
# Peticiones por minuto por usuario autenticado (o por IP sin sesión).
RATE_LIMIT_PER_MIN=300
# Conversiones DOCX→PDF simultáneas (LibreOffice usa ~150 MB por conversión).
LIBREOFFICE_MAX_CONCURRENCY=1
# Avisos de errores 5xx, base caída y caídas del proceso (ntfy.sh, Slack o Discord).
# En ntfy.sh usa un tema largo y aleatorio: cualquiera que lo adivine lee los avisos.
ALERT_WEBHOOK_URL=
ALERT_THROTTLE_MIN=15
