# ============================================================
# backend/.env.example — Plantilla de variables de entorno
# Gestor JAL v2.0 — Windows
# ============================================================
# INSTRUCCIONES:
#   1. Copia este archivo:  copy .env.example .env
#   2. Completa los valores indicados con "CAMBIAR"
#   3. NUNCA subas .env a git (ya está en .gitignore)
# ============================================================

# ── Base de datos (PostgreSQL local) ────────────────────────
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD
# Por defecto PostgreSQL en Windows usa el usuario 'postgres'
#
# Modo híbrido (backend en Render, Postgres en el PC local vía Tailscale):
# usa la IP de Tailscale del PC en vez de localhost, ej:
#   DATABASE_URL=postgresql://postgres:CAMBIAR_CONTRASEÑA@100.x.y.z:5432/gestor_jal
# Ver docs/DESPLIEGUE_HIBRIDO.md para el detalle completo.
DATABASE_URL=postgresql://postgres:CAMBIAR_CONTRASEÑA@localhost:5432/gestor_jal

# Fuerza (true) o desactiva (false) SSL en la conexión a Postgres, sin depender de la
# heurística automática (que activa SSL si el host de DATABASE_URL "tiene punto" — una
# IP de Tailscale también tiene puntos). Deja vacío para usar la heurística automática.
# Modo híbrido con Tailscale: DB_SSL=false (Postgres local no tiene certificados TLS).
DB_SSL=

# Variables individuales (usadas por el script de setup)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestor_jal
DB_USER=postgres
DB_PASSWORD=CAMBIAR_CONTRASEÑA

# ── JWT — Autenticación ──────────────────────────────────────
# Genera con: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=CAMBIAR_POR_UN_SECRET_LARGO_Y_ALEATORIO_MINIMO_32_CHARS

# Para RS256 (producción avanzada) — dejar vacíos para usar HS256 simple
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ── Servidor ─────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── CORS — Orígenes permitidos ───────────────────────────────
# Frontend local + URLs de ngrok se agregan automáticamente
# Modo híbrido: agrega el dominio de Vercel del frontend, ej:
#   ALLOWED_ORIGINS=https://gestor-jal.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Chat IA — Ollama (opcional) ───────────────────────────────
# Deja vacío si no usas el chat. En modo híbrido, Ollama sigue corriendo en el PC
# local — usa la misma IP/host de Tailscale que DATABASE_URL, no localhost.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# ── Almacenamiento de archivos ────────────────────────────────
# Ruta donde se guardan los documentos .docx/.pdf generados
STORAGE_PATH=./data/output
# Ruta de las plantillas .docx de la JAL
TEMPLATES_PATH=./plantillas
# Tamaño máximo de archivos subidos (MB)
MAX_FILE_SIZE_MB=20

# ── Configuración de la JAL ───────────────────────────────────
JAL_NOMBRE=JAL Comuna 12 - La América - Medellín
JAL_NOMBRE_CORTO=JAL C12

# ── ngrok — Acceso remoto gratuito ────────────────────────────
# Obtén tu token en: https://dashboard.ngrok.com/get-started/your-authtoken
# Dejar vacío para desactivar el túnel
NGROK_AUTHTOKEN=
# Dominio fijo (solo plan pago de ngrok) — dejar vacío si usas el gratuito
NGROK_DOMAIN=

# ── Notificaciones push (opcional) ───────────────────────────
# Genera con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@jal12.com
