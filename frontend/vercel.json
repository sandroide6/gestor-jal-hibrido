{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/v1/:path*", "destination": "https://gestor-jal-backend.onrender.com/v1/:path*" },
    { "source": "/health", "destination": "https://gestor-jal-backend.onrender.com/health" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
