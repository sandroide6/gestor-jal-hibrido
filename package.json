{
  "name": "gestor-jal",
  "version": "2.0.0",
  "private": true,
  "description": "Sistema de gestión documental para JAL de Medellín — Windows + ngrok",
  "scripts": {
    "setup":           "python gestor.py setup",
    "start":           "python gestor.py start",
    "stop":            "python gestor.py stop",
    "status":          "python gestor.py status",
    "tunnel":          "python gestor.py tunnel",
    "backup":          "python gestor.py backup",
    "dev:backend":     "npm run dev --prefix backend",
    "dev:frontend":    "npm run dev --prefix frontend",
    "install:all":     "npm install --prefix backend && npm install --prefix frontend",
    "build:frontend":  "npm run build --prefix frontend",
    "lint":            "npm run lint --prefix frontend && npm run lint --prefix backend",
    "test":            "npm run test --prefix backend"
  }
}
