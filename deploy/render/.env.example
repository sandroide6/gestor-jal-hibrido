# ══════════════════════════════════════════════════════════════════════════════
#  Gestor JAL — Variables de entorno del backend en Render (modo híbrido)
#  Referencia para llenar el dashboard de Render (o render.yaml) — este archivo NO
#  se sube como .env real, es solo documentación de qué poner y por qué.
# ══════════════════════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=3001

# ── Base de datos — Postgres del PC local, alcanzado vía Tailscale ─────────────
# Usa la IP de Tailscale del PC (100.x.y.z) o su nombre MagicDNS
# (ej. mi-pc.tailXXXXX.ts.net), NUNCA localhost/127.0.0.1 (eso apuntaría al propio
# contenedor de Render). Ver docs/DESPLIEGUE_HIBRIDO.md para cómo obtenerlo.
DATABASE_URL=postgresql://postgres:CAMBIAR_CONTRASEÑA@100.x.y.z:5432/gestor_jal
# El Postgres local no tiene certificados TLS configurados — desactivar SSL explícito
# en vez de dejar que la heurística automática lo active por ver un host con puntos.
DB_SSL=false

# ── Seguridad ────────────────────────────────────────────────────────────────
# Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR_clave_aleatoria_minimo_64_caracteres_hex
ENCRYPTION_KEY=CAMBIAR_clave_aleatoria_minimo_32_caracteres_hex

# ── CORS ─────────────────────────────────────────────────────────────────────
# Dominio(s) del frontend en Vercel — sin barra final, separados por coma si hay
# varios (ej. producción + preview deployments).
ALLOWED_ORIGINS=https://TU_FRONTEND.vercel.app

# ── Tailscale — conecta el contenedor de Render al tailnet del PC local ────────
# Auth key reusable, idealmente con tag propio (ej. tag:jal-backend) y ACL que solo
# le permita alcanzar el tag del PC (ej. tag:jal-db) en los puertos 5432 y 11434.
# Generar en: https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=CAMBIAR_tailscale_authkey
TS_HOSTNAME=gestor-jal-backend

# ── Almacenamiento ───────────────────────────────────────────────────────────
# El disco del backend en Render (free tier) es efímero — estas rutas son solo
# caché local mientras el contenedor vive; la copia durable vive en Postgres
# (columnas file_docx/file_pdf, ver backend/migrations/20260101000025-*).
STORAGE_PATH=/app/data/output
TEMPLATES_PATH=/app/plantillas

# ── Identidad de la JAL ───────────────────────────────────────────────────────
JAL_NOMBRE=JAL Comuna 12 - La América - Medellín
JAL_NOMBRE_CORTO=JAL C12

# ── Chat IA — Ollama corriendo en el PC local (opcional) ───────────────────────
# Mismo host/IP de Tailscale que DATABASE_URL, puerto de Ollama.
# Deja ambas vacías si no usas el chat.
OLLAMA_URL=http://100.x.y.z:11434
OLLAMA_MODEL=llama3.2:1b

# ── Backup Google Drive (opcional) ──────────────────────────────────────────
# El redirect URI debe actualizarse en Google Cloud Console con la URL pública
# de Render (no localhost).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://TU_BACKEND.onrender.com/v1/backup/drive/callback
