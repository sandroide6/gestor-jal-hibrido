# ── Etapa 1: compilar el frontend con Vite ───────────────────────────────────
FROM node:24-alpine AS builder
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci --ignore-scripts
COPY frontend/ .

# VITE_API_URL en /v1 hace que todas las llamadas sean relativas al mismo origen.
# Nginx redirige /v1/* al backend, así que no cambia entre local y túnel ngrok.
ARG VITE_API_URL=/v1
ARG VITE_JAL_NOMBRE="JAL"
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_JAL_NOMBRE=$VITE_JAL_NOMBRE

RUN npm run build

# ── Etapa 2: nginx sirviendo los archivos estáticos ───────────────────────────
FROM nginx:1.27-alpine AS runtime
COPY --from=builder /app/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
