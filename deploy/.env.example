# ══════════════════════════════════════════════════════════════════════════════
#  Gestor JAL — Variables de Entorno para Distribución Docker
#  Archivo: deploy/.env.example
#
#  INSTRUCCIONES:
#  1. Copia este archivo: cp deploy/.env.example deploy/.env
#  2. Rellena CADA variable marcada con  ← CAMBIAR
#  3. NUNCA subas deploy/.env a git (ya está en .gitignore)
#  4. Guarda una copia segura de deploy/.env fuera del proyecto (ej. gestor de contraseñas)
# ══════════════════════════════════════════════════════════════════════════════

# ── Base de datos ─────────────────────────────────────────────────────────────
# Nombre de la base de datos (puedes dejarlo como está)
DB_NAME=gestor_jal

# Usuario de PostgreSQL
DB_USER=postgres

# Contraseña de PostgreSQL — mínimo 16 caracteres, sin caracteres especiales que
# rompan la URL de conexión (evita @, /, ?, #, &)
DB_PASSWORD=CAMBIAR_contraseña_segura_min16chars   # ← CAMBIAR

# ── JWT — Clave de firma de tokens de sesión ──────────────────────────────────
# Genera una clave aleatoria con el siguiente comando y pégala aquí:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR_clave_aleatoria_minimo_64_caracteres_hex   # ← CAMBIAR

# ── Servidor ──────────────────────────────────────────────────────────────────
# Puerto donde el navegador accede al sistema (nginx)
# Usa 80 para HTTP estándar. Si el puerto 80 está ocupado, cambia a 8080 u otro.
FRONTEND_PORT=80

# Orígenes permitidos por CORS — separados por coma, sin espacios
# Incluye el dominio ngrok si usas acceso remoto (se detecta automáticamente)
ALLOWED_ORIGINS=http://localhost

# ── Identidad de la JAL ───────────────────────────────────────────────────────
JAL_NOMBRE=JAL Comuna 12 - La América - Medellín   # ← CAMBIAR según cliente
JAL_NOMBRE_CORTO=JAL C12                            # ← CAMBIAR según cliente

# ── Archivos ──────────────────────────────────────────────────────────────────
# Tamaño máximo permitido para subida de archivos (MB)
MAX_FILE_SIZE_MB=20

# ── ngrok — Acceso remoto (opcional) ─────────────────────────────────────────
# Si no usas acceso remoto, deja estos campos vacíos.
# Obtén tu token en: https://dashboard.ngrok.com/get-started/your-authtoken
# Si compartes el token entre instalaciones, cada una necesita su propio token.
NGROK_AUTHTOKEN=   # ← CAMBIAR (o dejar vacío si no se usa acceso remoto)
NGROK_DOMAIN=      # ← CAMBIAR a tu dominio estático ngrok, o vacío para URL aleatoria

# ── Google Drive Backup (opcional) ────────────────────────────────────────────
# Deja vacíos si no se usa backup en Google Drive.
# Instrucciones: README.md → sección "Backup en Google Drive"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/v1/backup/drive/callback

# ── Asistente IA — Ollama (opcional) ──────────────────────────────────────────
# Solo si el cliente tiene Ollama corriendo en el mismo equipo.
# Si no, el chat IA simplemente no estará disponible.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:1b
